# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/alanko

# MinIO Configuration
# MINIO_INTERNAL_URL - адрес MinIO внутри Docker сети (не трогать при локальной разработке)
# MINIO_PUBLIC_URL - публичный адрес для доступа из браузера
MINIO_INTERNAL_URL=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000

# При переносе на VPS:
# MINIO_PUBLIC_URL=http://your-domain.com:9000
# или
# MINIO_PUBLIC_URL=http://SERVER_IP:9000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
